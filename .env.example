# 노마(Noma) 환경변수 예시 — 코드(server.js, data/requestStore.mjs, scripts/)가 실제 참조하는 변수만 기재
# 복사: cp .env.example .env

# ── 서버 ──
PORT=5000
BASE_URL=http://localhost:5000
# production 이면 세션 쿠키 secure=true
NODE_ENV=development
# CORS 허용 도메인 (콤마 구분). 비우면 전체 허용
ALLOWED_ORIGINS=
# express-session 서명 키. 비우면 기동마다 랜덤 (재시작 시 세션 초기화)
SESSION_SECRET=

# ── 인증 (공유 비밀번호 1개) ──
# /api/auth/login, /api/unified-auth/login 공용. 필수
ADMIN_PASSWORD=

# ── 개인정보 암호화 ──
# requests.json의 이름·전화번호 AES-256-GCM 암호화 키. 64자 hex. 필수
# 생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ── 이메일 (Resend HTTP API) ──
# 비우면 발송 건너뜀
RESEND_API_KEY=
# 부서 이메일이 없을 때의 기본 수신자 (콤마 구분). 비우면 기본 수신자 없음
DEFAULT_RECIPIENTS=

# ── AI / RAG (도민 챗봇용, 파일럿 화면에는 불필요) ──
# 비우면 서버는 뜨지만 /api/chat 호출 시 실패
GOOGLE_GEMINI_API_KEY=
# 비우면 Supabase 없이 CSV/JSON 키워드 검색 폴백
SUPABASE_URL=
SUPABASE_KEY=
